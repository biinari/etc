# Initial and minimum number of heap slots
# (default: 10000)
#RUBY_HEAP_MIN_SLOTS=10000
RUBY_GC_HEAP_INIT_SLOTS=10000

# Number of new slots to allocate when all initial slots are used
# (default: 10000)
RUBY_HEAP_SLOTS_INCREMENT=10000

# New heap slots growth factor
# (default: 1.8)
RUBY_HEAP_SLOTS_GROWTH_FACTOR=1.4

# Number of C data structures that can be allocated before triggering the
# garbage collector.
# (default: 8000000)
RUBY_GC_MALLOC_LIMIT=8000000

# Number of free slots that should be present after GC finishes running. If
# there are fewer slots, it will allocate new slots.
# (default: 4096)
RUBY_HEAP_FREE_MIN=4096
